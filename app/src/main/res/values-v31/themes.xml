<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 原生 SplashScreen：使用品牌前景，不延长启动等待 -->
    <style name="Theme.Yuni" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF8EF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">#FFF8EF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFF8EF</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
